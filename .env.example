# Stock Footage API Keys
# Get your free key at https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key_here

# Get your free key at https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key_here

# YouTube Data API Credentials
# Mount your client secret and token under /app/storage/secrets/
YOUTUBE_CLIENT_SECRET_FILE=/app/storage/secrets/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=/app/storage/secrets/youtube_token.json

# Optional: Default TTS Voice Override
EDGE_TTS_VOICE=en-US-ChristopherNeural

# Pipeline Environment
LOG_LEVEL=INFO
APP_ENV=production
